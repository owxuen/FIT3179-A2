{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Fewer Farms, But Much Bigger Farms",
    "subtitle": "Since 1990, the average surveyed dairy farm has nearly tripled its herd size while milk output per farm has grown almost fivefold.",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666666",
    "offset": 18
  },

  "width": 760,
  "height": 400,

  "data": {
    "url": "vis03_average_farm_transformation.csv"
  },

  "transform": [
    {
      "calculate": "datum.year == 1990 ? '113 cows' : '324 cows'",
      "as": "cow_label"
    },
    {
      "calculate": "datum.year == 1990 ? '426,869 L' : '2,042,992 L'",
      "as": "milk_label"
    },
    {
      "calculate": "datum.year == 1990 ? '1990' : '2025'",
      "as": "year_label"
    }
  ],

