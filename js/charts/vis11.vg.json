{
  "$schema": "https://vega.github.io/schema/vega/v5.json",

  "width": 940,
  "height": 530,

  "padding": {
    "top": 85,
    "left": 25,
    "right": 65,
    "bottom": 40
  },

  "autosize": "none",

  "title": {
    "text": "More Tonnes Don’t Always Mean More Value",
    "subtitle": "Similar export volumes can produce very different economic value across Australia’s dairy markets (2024–25).",
    "anchor": "start",
    "frame": "group",
    "font": "Arial",
    "fontSize": 20,
    "fontWeight": "bold",
    "color": "#222222",
    "subtitleFont": "Arial",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "offset": 22
  },

  "data": [
    {
      "name": "markets",

      "url": "vis10_export_market_ranks.csv",

      "format": {
        "type": "csv",

        "parse": {
          "volume_tonnes": "number",
          "volume_rank": "number",
          "value_per_tonne": "number",
          "price_rank": "number",
          "value_aud_m": "number",
          "value_rank": "number"
        }
      },

      "transform": [
        {
          "type": "formula",
          "as": "lineWidth",
          "expr": "datum.country === 'Indonesia' || datum.country === 'Singapore' ? 4 : 2"
        },

        {
          "type": "formula",
          "as": "lineOpacity",
          "expr": "datum.country === 'Indonesia' || datum.country === 'Singapore' ? 1 : 0.65"
        }
      ]
    },

    {
      "name": "japan",

      "source": "markets",

      "transform": [
        {
          "type": "filter",
          "expr": "datum.country === 'Japan'"
        }
      ]
    },

    {
      "name": "singapore",

      "source": "markets",

      "transform": [
        {
          "type": "filter",
          "expr": "datum.country === 'Singapore'"
        }
      ]
    },

    {
      "name": "indonesia",

      "source": "markets",

      "transform": [
        {
          "type": "filter",
          "expr": "datum.country === 'Indonesia'"
        }
      ]
    },

    {
      "name": "stages",

      "values": [
        {
          "stage": "VOLUME RANK",
          "x": 150,
          "subtitle": "Export tonnes"
        },

        {
          "stage": "VALUE PER TONNE RANK",
          "x": 450,
          "subtitle": "A$ per tonne"
        },

        {
          "stage": "TOTAL VALUE RANK",
          "x": 750,
          "subtitle": "Export value (A$m)"
        }
      ]
    },

    {
      "name": "ranks",

      "values": [
        {"rank": 1},
        {"rank": 2},
        {"rank": 3},
        {"rank": 4},
        {"rank": 5},
        {"rank": 6},
        {"rank": 7},
        {"rank": 8},
        {"rank": 9},
        {"rank": 10}
      ]
    }
  ],

  "scales": [
    {
      "name": "rankY",
      "type": "linear",
      "domain": [1, 10],
      "range": [55, 455],
      "zero": false,
      "nice": false
    },

    {
      "name": "marketColor",

      "type": "ordinal",

      "domain": [
        "Greater China",
        "Japan",
        "Malaysia",
        "Singapore",
        "Indonesia",
        "Thailand",
        "Vietnam",
        "Philippines",
        "South Korea",
        "New Zealand"
      ],

      "range": [
        "#1B4D3E",
        "#2A9D8F",
        "#457B9D",
        "#75658A",
        "#D95F02",
        "#E9C46A",
        "#52B788",
        "#F4A261",
        "#3D5A80",
        "#8D99AE"
      ]
    }
  ],

  "marks": [
    {
      "type": "rule",

      "from": {
        "data": "ranks"
      },

      "encode": {
        "enter": {
          "x": {
            "value": 56
          },

          "x2": {
            "value": 765
          },

          "y": {
            "scale": "rankY",
            "field": "rank"
          },

          "stroke": {
            "value": "#F0F0EC"
          },

          "strokeWidth": {
            "value": 1
          }
        }
      }
    },

    {
      "type": "rule",

      "from": {
        "data": "stages"
      },

      "encode": {
        "enter": {
          "x": {
            "field": "x"
          },

          "y": {
            "value": 45
          },

          "y2": {
            "value": 465
          },

          "stroke": {
            "value": "#D7D7D2"
          },

          "strokeWidth": {
            "value": 1
          }
        }
      }
    },

    {
      "type": "text",

      "from": {
        "data": "stages"
      },

      "encode": {
        "enter": {
          "x": {
            "field": "x"
          },

          "y": {
            "value": 5
          },

          "text": {
            "field": "stage"
          },

          "align": {
            "value": "center"
          },

          "baseline": {
            "value": "bottom"
          },

          "font": {
            "value": "Arial"
          },

          "fontSize": {
            "value": 12
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#333333"
          }
        }
      }
    },

    {
      "type": "text",

      "from": {
        "data": "stages"
      },

      "encode": {
        "enter": {
          "x": {
            "field": "x"
          },

          "y": {
            "value": 22
          },

          "text": {
            "field": "subtitle"
          },

          "align": {
            "value": "center"
          },

          "baseline": {
            "value": "bottom"
          },

          "font": {
            "value": "Arial"
          },

          "fontSize": {
            "value": 10
          },

          "fill": {
            "value": "#777777"
          }
        }
      }
    },

    {
      "type": "text",

      "from": {
        "data": "ranks"
      },

      "encode": {
        "enter": {
          "x": {
            "value": 48
          },

          "y": {
            "scale": "rankY",
            "field": "rank"
          },

          "text": {
            "signal": "'#' + datum.rank"
          },

          "align": {
            "value": "right"
          },

          "baseline": {
            "value": "middle"
          },

          "font": {
            "value": "Arial"
          },

          "fontSize": {
            "value": 10
          },

          "fill": {
            "value": "#888888"
          }
        }
      }
    },

    {
      "type": "path",

      "from": {
        "data": "markets"
      },

      "encode": {
        "enter": {
          "fill": {
            "value": null
          },

          "strokeCap": {
            "value": "round"
          },

          "strokeJoin": {
            "value": "round"
          },

          "tooltip": {
            "signal": "{'Market': datum.country, 'Export volume': format(datum.volume_tonnes, ',') + ' tonnes', 'Volume rank': '#' + datum.volume_rank, 'Value per tonne': 'A$' + format(datum.value_per_tonne, ',') + '/t', 'Value per tonne rank': '#' + datum.price_rank, 'Export value': 'A$' + format(datum.value_aud_m, ',') + 'm', 'Value rank': '#' + datum.value_rank}"
          }
        },

        "update": {
          "path": {
            "signal": "'M150,' + scale('rankY', datum.volume_rank) + ' C250,' + scale('rankY', datum.volume_rank) + ' 350,' + scale('rankY', datum.price_rank) + ' 450,' + scale('rankY', datum.price_rank) + ' C550,' + scale('rankY', datum.price_rank) + ' 650,' + scale('rankY', datum.value_rank) + ' 750,' + scale('rankY', datum.value_rank)"
          },

          "stroke": {
            "scale": "marketColor",
            "field": "country"
          },

          "strokeWidth": {
            "field": "lineWidth"
          },

          "strokeOpacity": {
            "field": "lineOpacity"
          }
        },

        "hover": {
          "strokeOpacity": {
            "value": 1
          },

          "strokeWidth": {
            "value": 5
          }
        }
      }
    },

    {
      "type": "symbol",

      "from": {
        "data": "markets"
      },

      "encode": {
        "enter": {
          "shape": {
            "value": "circle"
          },

          "stroke": {
            "value": "#FFFFFF"
          },

          "strokeWidth": {
            "value": 1.5
          },

          "tooltip": {
            "signal": "{'Market': datum.country, 'Export volume': format(datum.volume_tonnes, ',') + ' tonnes', 'Volume rank': '#' + datum.volume_rank, 'Value per tonne': 'A$' + format(datum.value_per_tonne, ',') + '/t', 'Value per tonne rank': '#' + datum.price_rank, 'Export value': 'A$' + format(datum.value_aud_m, ',') + 'm', 'Value rank': '#' + datum.value_rank}"
          }
        },

        "update": {
          "x": {
            "value": 150
          },

          "y": {
            "scale": "rankY",
            "field": "volume_rank"
          },

          "size": {
            "signal": "datum.country === 'Indonesia' || datum.country === 'Singapore' ? 105 : 75"
          },

          "fill": {
            "scale": "marketColor",
            "field": "country"
          },

          "opacity": {
            "value": 1
          }
        }
      }
    },

    {
