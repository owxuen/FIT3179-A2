          "update": "event.item.mark.name === 'linked_flows' ? {product: datum.product, region: datum.region} : indexof(event.item.mark.name, 'linked_products') === 0 ? {product: datum.name, region: null} : {product: null, region: datum.name}"
        },
        {
          "events": "mouseout",
          "update": "null"
