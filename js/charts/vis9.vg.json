      "type": "path",
      "from": {
        "data": "flows"
      },
      "encode": {
        "enter": {
          "stroke": {
            "scale": "productColor",
            "field": "product"
          },
          "strokeOpacity": {
            "value": 0.42
          },
          "strokeWidth": {
            "field": "strokeWidth"
          },
          "tooltip": {
            "field": "tooltipText"
          }
        },

        "update": {
          "path": {
            "signal": "'M' + (leftX + nodeWidth) + ',' + datum.sy + ' C' + ((leftX + rightX) / 2) + ',' + datum.sy + ' ' + ((leftX + rightX) / 2) + ',' + datum.ty + ' ' + rightX + ',' + datum.ty"
          }
        },

        "hover": {
          "strokeOpacity": {
            "value": 0.95
          }
        }
      }
    },

