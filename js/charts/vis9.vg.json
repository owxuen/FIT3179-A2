    {
      "type": "path",
      "from": {
        "data": "flows"
      },
      "encode": {
        "enter": {
          "stroke": {
            "scale": "productColor",
            "field": "product"
          },
          "strokeWidth": {
            "field": "strokeWidth"
          },
          "tooltip": {
            "field": "tooltipText"
          }
        },
        "update": {
          "path": {
            "signal": "'M' + (leftX + nodeWidth) + ',' + datum.sy + ' C' + ((leftX + rightX) / 2) + ',' + datum.sy + ' ' + ((leftX + rightX) / 2) + ',' + datum.ty + ' ' + rightX + ',' + datum.ty"
          },
          "strokeOpacity": {
            "signal": "hoverConnection === null ? 0.42 : (hoverConnection.product === null || datum.product === hoverConnection.product) && (hoverConnection.region === null || datum.region === hoverConnection.region) ? 0.95 : 0.06"
          }
        }
      },
      "name": "linked_flows"
    },
    {
      "type": "rect",
      "from": {
        "data": "products"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "leftX"
          },
          "x2": {
            "signal": "leftX + nodeWidth"
          },
          "y": {
            "field": "y"
          },
          "height": {
            "field": "h"
          },
          "fill": {
            "scale": "productColor",
            "field": "name"
          },
          "cornerRadius": {
            "value": 2
          },
          "tooltip": {
            "signal": "datum.name + ': A$' + format(datum.value, ',') + 'm'"
          }
        },
        "update": {
          "opacity": {
            "signal": "hoverConnection === null || (hoverConnection.product !== null ? datum.name === hoverConnection.product : indata('flows', 'connectionKey', datum.name + '|' + hoverConnection.region)) ? 1 : 0.25"
          }
        }
      },
      "name": "linked_products_3"
    },
