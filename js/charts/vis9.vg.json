      "type": "rect",
      "from": {
        "data": "products"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "leftX"
          },
          "x2": {
            "signal": "leftX + nodeWidth"
          },
          "y": {
            "field": "y"
          },
          "height": {
            "field": "h"
          },
          "fill": {
            "scale": "productColor",
            "field": "name"
          },
          "cornerRadius": {
            "value": 2
          },
          "tooltip": {
            "signal": "datum.name + ': A$' + format(datum.value, ',') + 'm'"
          }
        }
      }
    },

