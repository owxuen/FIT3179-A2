      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "normal",
        "color": "#666666",
        "align": "left"
      },
      "encoding": {
        "theta": {
          "field": "angle",
          "type": "quantitative",
          "scale": null
        },
        "radius": {
          "field": "radius_value",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "2024–25",
            "angle": 0.08,
            "radius_value": 255
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#2F6B4F",
        "align": "left"
      },
      "encoding": {
        "theta": {
          "field": "angle",
          "type": "quantitative",
          "scale": null
        },
        "radius": {
