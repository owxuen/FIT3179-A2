          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "normal",
        "color": "#C46A2D",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "dy": 17
      },
      "encoding": {
        "theta": {
          "field": "angle",
          "type": "quantitative",
          "scale": null
        },
        "radius": {
          "field": "radius_value",
          "type": "quantitative",
          "scale": null
        },
        "text": {
