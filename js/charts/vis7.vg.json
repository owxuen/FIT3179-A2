{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Milk Production Follows a Seasonal Rhythm",
    "subtitle": "Across five seasons, production rises through spring before declining toward winter.",
    "anchor": "start",
    "fontSize": 20,
    "fontWeight": "bold",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "offset": 18
  },
  "width": 650,
  "height": 650,
  "data": {
    "url": "../../data/vis07_monthly_seasonality.csv"
  },
  "transform": [
    {
      "calculate": "datum.season === '2020-21' ? 0 : datum.season === '2021-22' ? 1 : datum.season === '2022-23' ? 2 : datum.season === '2023-24' ? 3 : 4",
      "as": "season_order"
    },
    {
      "calculate": "(datum.month_order - 1) / 12 * 6.28318530718",
      "as": "start_angle"
    },
    {
      "calculate": "datum.month_order / 12 * 6.28318530718",
      "as": "end_angle"
    },
    {
      "calculate": "85 + datum.season_order * 38",
      "as": "inner_radius"
    },
    {
      "calculate": "85 + (datum.season_order + 1) * 38 - 2",
      "as": "outer_radius"
    },
    {
      "calculate": "['July', 'August', 'September', 'October', 'November', 'December', 'January', 'February', 'March', 'April', 'May', 'June'][datum.month_order - 1]",
      "as": "month_full"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "stroke": "#FFFFFF",
        "strokeWidth": 2
      },
      "encoding": {
        "theta": {
          "field": "start_angle",
          "type": "quantitative",
          "scale": null
        },
        "theta2": {
          "field": "end_angle"
        },
        "radius": {
          "field": "outer_radius",
          "type": "quantitative",
          "scale": null
        },
        "radius2": {
          "field": "inner_radius"
        },
        "color": {
          "field": "milk_production_ml",
          "type": "quantitative",
          "scale": {
            "domain": [
              550,
              1000
            ],
            "range": [
              "#EDF4EF",
              "#C7DDCE",
              "#91B79F",
              "#5C8F70",
              "#2F6B4F"
            ]
          },
          "legend": {
            "title": "Milk production (ML)",
            "orient": "right",
            "gradientLength": 150,
            "gradientThickness": 12,
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "labelFontSize": 11,
            "titleColor": "#444444",
            "labelColor": "#666666"
          }
        },
        "tooltip": [
          {
            "field": "season",
            "type": "nominal",
            "title": "Season"
          },
          {
            "field": "month_full",
            "type": "ordinal",
            "title": "Month"
          },
          {
            "field": "milk_production_ml",
            "type": "quantitative",
            "title": "Milk production (ML)",
            "format": ",.0f"
          }
        ],
        "opacity": {
          "condition": {
            "param": "hoverMonth",
            "value": 1
          },
          "value": 0.25
        }
      },
      "params": [
        {
          "name": "hoverMonth",
          "select": {
            "type": "point",
            "fields": [
              "month"
            ],
            "on": "mouseover[event.item && event.item.datum && event.item.datum.season]",
            "clear": "mouseout",
            "toggle": false
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.season === '2024-25' && datum.month === 'Oct'"
        }
      ],
      "mark": {
        "type": "arc",
        "fillOpacity": 0,
        "stroke": "#C46A2D",
        "strokeWidth": 4,
        "interactive": false
      },
      "encoding": {
        "theta": {
          "field": "start_angle",
          "type": "quantitative",
          "scale": null
        },
        "theta2": {
          "field": "end_angle"
        },
        "radius": {
          "field": "outer_radius",
          "type": "quantitative",
          "scale": null
        },
        "radius2": {
          "field": "inner_radius"
        },
        "opacity": {
          "condition": {
            "param": "hoverMonth",
            "value": 1
          },
          "value": 0.25
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "month": "July",
            "month_order": 1
          },
          {
            "month": "August",
            "month_order": 2
          },
          {
            "month": "September",
            "month_order": 3
          },
          {
            "month": "October",
            "month_order": 4
          },
          {
            "month": "November",
            "month_order": 5
          },
          {
            "month": "December",
            "month_order": 6
          },
          {
            "month": "January",
            "month_order": 7
          },
          {
            "month": "February",
            "month_order": 8
          },
          {
            "month": "March",
            "month_order": 9
          },
          {
            "month": "April",
            "month_order": 10
          },
          {
            "month": "May",
            "month_order": 11
          },
          {
            "month": "June",
            "month_order": 12
          }
        ]
      },
      "transform": [
        {
          "calculate": "(datum.month_order - 0.5) / 12 * 6.28318530718",
          "as": "label_angle"
        }
      ],
      "mark": {
        "type": "text",
        "radius": 305,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#555555"
      },
      "encoding": {
        "theta": {
          "field": "label_angle",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "month"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "2020\u201321",
            "angle": 0.08,
            "radius_value": 103
          },
          {
            "label": "2021\u201322",
            "angle": 0.08,
            "radius_value": 141
          },
          {
            "label": "2022\u201323",
            "angle": 0.08,
            "radius_value": 179
          },
          {
            "label": "2023\u201324",
            "angle": 0.08,
            "radius_value": 217
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "normal",
        "color": "#666666",
        "align": "left"
      },
      "encoding": {
        "theta": {
          "field": "angle",
          "type": "quantitative",
          "scale": null
        },
        "radius": {
          "field": "radius_value",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "2024\u201325",
            "angle": 0.08,
            "radius_value": 255
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#2F6B4F",
        "align": "left"
      },
      "encoding": {
        "theta": {
          "field": "angle",
          "type": "quantitative",
          "scale": null
        },
        "radius": {
          "field": "radius_value",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#A85B27",
        "align": "center",
        "interactive": false
      },
      "encoding": {
        "x": {
          "value": 325
        },
        "y": {
          "value": 660
        },
        "text": {
          "value": "October 2024: 945 ML \u2014 the 2024\u201325 peak"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "lineHeight": 15,
        "align": "center",
        "color": "#355542",
        "interactive": false
      },
      "encoding": {
        "x": {
          "value": 325
        },
        "y": {
          "value": 313
        },
        "text": {
          "value": [
            "Monthly totals",
            "February has fewer",
            "production days"
          ]
        }
      }
    }
  ],
  "config": {
    "background": "white",
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}
