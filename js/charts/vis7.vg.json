        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#EDF4EF",
        "stroke": "#B7D2BF",
        "strokeWidth": 1,
        "cornerRadius": 6,
        "interactive": false
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "x2": {
          "value": 650
        },
        "y": {
          "value": 670
