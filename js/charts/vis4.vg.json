{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Where Are Australia’s Highest-Yielding Dairy Cows?",
    "subtitle": "South Australia recorded the highest milk output per cow in 2024–25, while Queensland recorded the lowest.",
    "anchor": "start",
    "fontSize": 20,
    "fontWeight": "bold",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "offset": 18
  },

  "width": 700,
  "height": 520,

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "data": {
        "url": "australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#E8E8E8",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },

      "encoding": {
        "tooltip": [
          {
            "field": "properties.STE_NAME21",
            "type": "nominal",
            "title": "State / Territory"
          }
        ]
      }
    },

    {
      "data": {
        "url": "australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },

      "transform": [
        {
          "lookup": "properties.STE_NAME21",
          "from": {
            "data": {
              "url": "vis04_state_milk_yield.csv"
            },
            "key": "state",
            "fields": [
              "milk_ml",
              "cows_thousand",
              "yield_l_per_cow"
            ]
          }
        },
        {
          "filter": "isValid(datum.yield_l_per_cow)"
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },

      "encoding": {
        "color": {
          "field": "yield_l_per_cow",
          "type": "quantitative",
          "title": "Milk yield (L/cow)",

          "scale": {
            "domain": [4600, 7400],
            "range": [
              "#DCE9DF",
              "#B7D2BF",
              "#8DB99C",
              "#5E9272",
              "#2F6B4F"
            ]
          },

          "legend": {
            "orient": "right",
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "labelFontSize": 11,
            "gradientLength": 200,
            "gradientThickness": 14,
            "format": ",.0f"
          }
        },

        "tooltip": [
          {
            "field": "properties.STE_NAME21",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "yield_l_per_cow",
            "type": "quantitative",
            "title": "Milk yield (L/cow)",
            "format": ",.0f"
          },
          {
            "field": "milk_ml",
            "type": "quantitative",
            "title": "Milk production (ML)",
            "format": ",.0f"
          },
          {
            "field": "cows_thousand",
            "type": "quantitative",
            "title": "Dairy cows ('000)",
            "format": ",.0f"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "longitude": 134.5,
            "latitude": -29.3,
            "label": "Highest"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#FFFFFF"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "longitude": 134.5,
            "latitude": -30.4,
            "label": "7,359 L/cow"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#FFFFFF"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "longitude": 133.5,
            "latitude": -20.5,
            "label": "NT"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#888888"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "longitude": 133.5,
            "latitude": -21.6,
            "label": "No data"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 10,
        "color": "#999999"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],

  "config": {
    "background": "white",

    "view": {
      "stroke": null
    },

    "legend": {
      "labelColor": "#555555",
      "titleColor": "#333333",
      "padding": 10
    }
  }
}