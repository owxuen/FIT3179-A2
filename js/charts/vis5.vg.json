{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Where Has Milk Production Grown — and Declined?",
    "subtitle": "Tasmania was the only state to grow, while Victoria recorded the largest absolute decline in milk production.",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666666",
    "offset": 16
  },

  "width": 700,
  "height": 520,

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "data": {
        "url": "australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#F2F2F2",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      }
    },

    {
      "data": {
        "values": [
          {
            "state": "Western Australia",
            "state_code": "WA",
            "longitude": 121.5,
            "latitude": -25.5,
            "production_2006_07": 349,
            "production_2024_25": 331,
            "change_pct": -5.2
          },
          {
            "state": "South Australia",
            "state_code": "SA",
            "longitude": 135.5,
            "latitude": -30.0,
            "production_2006_07": 655,
            "production_2024_25": 471,
            "change_pct": -28.1
          },
          {
            "state": "Queensland",
            "state_code": "QLD",
            "longitude": 145.0,
            "latitude": -23.5,
            "production_2006_07": 537,
            "production_2024_25": 275,
            "change_pct": -48.8
          },
          {
            "state": "New South Wales",
            "state_code": "NSW",
            "longitude": 147.0,
            "latitude": -32.5,
            "production_2006_07": 1104,
            "production_2024_25": 1071,
            "change_pct": -3.0
          },
          {
            "state": "Victoria",
            "state_code": "VIC",
            "longitude": 144.5,
            "latitude": -37.0,
            "production_2006_07": 6297,
            "production_2024_25": 5266,
            "change_pct": -16.4
          },
          {
            "state": "Tasmania",
            "state_code": "TAS",
            "longitude": 146.5,
            "latitude": -42.0,
            "production_2006_07": 641,
            "production_2024_25": 901,
            "change_pct": 40.6
          }
        ]
      },

      "transform": [
        {
          "calculate": "datum.production_2024_25 - datum.production_2006_07",
          "as": "change_ml"
        },
        {
          "calculate": "abs(datum.change_ml)",
          "as": "change_magnitude"
        },
        {
          "calculate": "datum.change_ml > 0 ? 'Growth' : 'Decline'",
          "as": "direction"
        }
      ],

      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "stroke": "#FFFFFF",
        "strokeWidth": 2
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "change_magnitude",
          "type": "quantitative",
          "title": "Absolute change (ML)",

          "scale": {
            "domain": [0, 1050],
            "range": [80, 3000]
          },

          "legend": {
            "orient": "right",
            "title": "Absolute change (ML)",
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "labelFontSize": 11,
            "format": ",.0f",
            "values": [250, 500, 1000]
          }
        },

        "color": {
          "field": "direction",
          "type": "nominal",
          "title": "Direction",

          "scale": {
            "domain": [
              "Growth",
              "Decline"
            ],
            "range": [
              "#2F6B4F",
              "#6F6F6F"
            ]
          },

          "legend": {
            "orient": "right",
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "labelFontSize": 11,
            "symbolSize": 120
          }
        },

        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "production_2006_07",
            "type": "quantitative",
            "title": "2006–07 production (ML)",
            "format": ",.0f"
          },
          {
            "field": "production_2024_25",
            "type": "quantitative",
            "title": "2024–25 production (ML)",
            "format": ",.0f"
          },
          {
            "field": "change_ml",
            "type": "quantitative",
            "title": "Production change (ML)",
            "format": "+,.0f"
          },
          {
            "field": "change_pct",
            "type": "quantitative",
            "title": "Percentage change",
            "format": "+.1f"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "longitude": 144.5,
            "latitude": -37.0,
            "label": "-1,031 ML"
          }
        ]
      },

      "mark": {
        "type": "text",
        "dx": -40,
        "dy": -10,
        "align": "right",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#6F6F6F"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "longitude": 144.5,
            "latitude": -37.0,
            "label": "largest absolute decline"
          }
        ]
      },

      "mark": {
        "type": "text",
        "dx": -40,
        "dy": 8,
        "align": "right",
        "baseline": "middle",
        "fontSize": 10,
        "color": "#6F6F6F"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "longitude": 145.0,
            "latitude": -23.5,
            "label": "-48.8%"
          }
        ]
      },

      "mark": {
        "type": "text",
        "dx": 32,
        "dy": -10,
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#6F6F6F"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "longitude": 145.0,
            "latitude": -23.5,
            "label": "largest percentage decline"
          }
        ]
      },

      "mark": {
        "type": "text",
        "dx": 32,
        "dy": 8,
        "align": "left",
        "baseline": "middle",
        "fontSize": 10,
        "color": "#6F6F6F"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "longitude": 146.5,
            "latitude": -42.0,
            "label": "+260 ML"
          }
        ]
      },

      "mark": {
        "type": "text",
        "dx": 32,
        "dy": -4,
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#2F6B4F"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "longitude": 146.5,
            "latitude": -42.0,
            "label": "only state to grow"
          }
        ]
      },

      "mark": {
        "type": "text",
        "dx": 32,
        "dy": 14,
        "align": "left",
        "baseline": "middle",
        "fontSize": 10,
        "color": "#2F6B4F"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],

  "config": {
    "background": "white",

    "view": {
      "stroke": null
    },

    "legend": {
      "labelColor": "#555555",
      "titleColor": "#333333",
      "padding": 10
    }
  }
}