{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Has Milk Production Grown \u2014 and Declined?",
    "subtitle": [
      "Choose a starting year to compare each state's milk production with 2024\u201325."
    ],
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666666",
    "offset": 16
  },
  "params": [
    {
      "name": "startYear",
      "value": "2006-07",
      "bind": {
        "input": "select",
        "name": "Compare 2024\u201325 with: ",
        "options": [
          "2006-07",
          "2007-08",
          "2008-09",
          "2009-10",
          "2010-11",
          "2011-12",
          "2012-13",
          "2013-14",
          "2014-15",
          "2015-16",
          "2016-17",
          "2017-18",
          "2018-19",
          "2019-20",
          "2020-21",
          "2021-22",
          "2022-23",
          "2023-24"
        ],
        "labels": [
          "2006\u201307",
          "2007\u201308",
          "2008\u201309",
          "2009\u201310",
          "2010\u201311",
          "2011\u201312",
          "2012\u201313",
          "2013\u201314",
          "2014\u201315",
          "2015\u201316",
          "2016\u201317",
          "2017\u201318",
          "2018\u201319",
          "2019\u201320",
          "2020\u201321",
          "2021\u201322",
          "2022\u201323",
          "2023\u201324"
        ]
      }
    }
  ],
  "config": {
    "background": "white",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelColor": "#555555",
      "titleColor": "#333333",
      "padding": 10
    }
  },
  "width": 700,
  "height": 520,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F2F2F2",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === startYear || datum.year === '2024-25'"
        },
        {
          "pivot": "year",
          "value": "production",
          "groupby": [
            "state",
            "state_code",
            "longitude",
            "latitude"
          ]
        },
        {
          "calculate": "datum['2024-25'] - datum[startYear]",
          "as": "change_ml"
        },
        {
          "calculate": "abs(datum.change_ml)",
          "as": "change_magnitude"
        },
        {
          "calculate": "datum.change_ml > 0 ? 'Growth' : datum.change_ml < 0 ? 'Decline' : 'No change'",
          "as": "direction"
        },
        {
          "calculate": "(datum.change_ml / datum[startYear]) * 100",
          "as": "change_pct"
        },
        {
          "calculate": "replace(startYear, '-', '\u2013')",
          "as": "start_year_label"
        },
        {
          "calculate": "datum[startYear]",
          "as": "start_production"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "stroke": "#FFFFFF",
        "strokeWidth": 2
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "change_magnitude",
          "type": "quantitative",
          "title": "Absolute change (ML)",
          "scale": {
            "domain": [
              0,
              1200
            ],
            "range": [
              80,
              3000
            ]
          },
          "legend": {
            "orient": "right",
            "title": "Absolute change (ML)",
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "labelFontSize": 11,
            "format": ",.0f",
            "values": [
              250,
              500,
              1000
            ]
          }
        },
        "color": {
          "field": "direction",
          "type": "nominal",
          "title": "Direction",
          "scale": {
            "domain": [
              "Growth",
              "Decline",
              "No change"
            ],
            "range": [
              "#009E60",
              "#6F6F6F",
              "#BDBDBD"
            ]
          },
          "legend": {
            "orient": "right",
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "labelFontSize": 11,
            "symbolSize": 120
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "start_year_label",
            "type": "nominal",
            "title": "Starting year"
          },
          {
            "field": "start_production",
            "type": "quantitative",
            "title": "Starting production (ML)",
            "format": ",.0f"
          },
          {
            "field": "2024-25",
            "type": "quantitative",
            "title": "2024\u201325 production (ML)",
            "format": ",.0f"
          },
          {
            "field": "change_ml",
            "type": "quantitative",
            "title": "Production change (ML)",
            "format": "+,.0f"
          },
          {
            "field": "change_pct",
            "type": "quantitative",
            "title": "Percentage change",
            "format": "+.1f"
          }
        ]
      },
      "data": {
        "name": "state_production_history"
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#EDF4EF",
        "stroke": "#B7D2BF",
        "strokeWidth": 1,
        "cornerRadius": 6,
        "interactive": false
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "x2": {
          "value": 700
        },
        "y": {
          "value": 540
        },
        "y2": {
          "value": 588
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "lineHeight": 15,
        "color": "#355542",
        "interactive": false
      },
      "encoding": {
        "x": {
          "value": 12
        },
        "y": {
          "value": 549
        },
        "text": {
          "value": [
            "Bubble area shows change in ML, not percentage change; a large producer can have a large bubble but a modest",
            "percentage shift."
          ]
        }
      }
    },
    {
      "data": {
        "name": "state_production_history"
      },
      "transform": [
        {
          "filter": "datum.year === startYear || datum.year === '2024-25'"
        },
        {
          "pivot": "year",
          "value": "production",
          "groupby": [
            "state",
            "state_code",
            "longitude",
            "latitude"
          ]
        },
        {
          "calculate": "datum['2024-25'] - datum[startYear]",
          "as": "change_ml"
        },
        {
          "calculate": "abs(datum.change_ml)",
          "as": "change_magnitude"
        },
        {
          "calculate": "datum.change_ml > 0 ? 'Growth' : datum.change_ml < 0 ? 'Decline' : 'No change'",
          "as": "direction"
        },
        {
          "calculate": "(datum.change_ml / datum[startYear]) * 100",
          "as": "change_pct"
        },
        {
          "calculate": "replace(startYear, '-', '\u2013')",
          "as": "start_year_label"
        },
        {
          "calculate": "datum[startYear]",
          "as": "start_production"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "loss_order"
            }
          ],
          "sort": [
            {
              "field": "change_ml",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.loss_order === 1"
        },
        {
          "calculate": "(datum.change_ml < 0 ? 'Largest loss in litres: ' : 'Smallest rise in litres: ') + datum.state + ' (' + format(datum.change_ml, '+,.0f') + ' ML' + ')'",
          "as": "comparison_note"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 16,
        "fontWeight": "bold",
        "color": "#355542",
        "interactive": false,
        "lineHeight": 20
      },
      "encoding": {
        "x": {
          "value": 12
        },
        "y": {
          "value": -64
        },
        "text": {
          "field": "comparison_note"
        }
      }
    },
    {
      "data": {
        "name": "state_production_history"
      },
      "transform": [
        {
          "filter": "datum.year === startYear || datum.year === '2024-25'"
        },
        {
          "pivot": "year",
          "value": "production",
          "groupby": [
            "state",
            "state_code",
            "longitude",
            "latitude"
          ]
        },
        {
          "calculate": "datum['2024-25'] - datum[startYear]",
          "as": "change_ml"
        },
        {
          "calculate": "abs(datum.change_ml)",
          "as": "change_magnitude"
        },
        {
          "calculate": "datum.change_ml > 0 ? 'Growth' : datum.change_ml < 0 ? 'Decline' : 'No change'",
          "as": "direction"
        },
        {
          "calculate": "(datum.change_ml / datum[startYear]) * 100",
          "as": "change_pct"
        },
        {
          "calculate": "replace(startYear, '-', '\u2013')",
          "as": "start_year_label"
        },
        {
          "calculate": "datum[startYear]",
          "as": "start_production"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "pct_order"
            }
          ],
          "sort": [
            {
              "field": "change_pct",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.pct_order === 1"
        },
        {
          "calculate": "(datum.change_pct < 0 ? 'Largest percentage fall: ' : 'Smallest percentage rise: ') + datum.state + ' (' + format(datum.change_pct, '+.1f') + '%' + ')'",
          "as": "comparison_note"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 16,
        "fontWeight": "bold",
        "color": "#355542",
        "interactive": false,
        "lineHeight": 20
      },
      "encoding": {
        "x": {
          "value": 12
        },
        "y": {
          "value": -34
        },
        "text": {
          "field": "comparison_note"
        }
      }
    }
  ],
