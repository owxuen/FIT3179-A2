{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Has Milk Production Grown — and Declined?",
    "subtitle": [
      "Choose a starting year to compare each state's milk production with 2024–25."
    ],
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666666",
    "offset": 16
  },
  "params": [
    {
      "name": "startYear",
      "value": "2006-07",
      "bind": {
        "input": "select",
        "name": "Compare 2024–25 with: ",
        "options": [
          "2006-07",
          "2007-08",
          "2008-09",
          "2009-10",
          "2010-11",
          "2011-12",
          "2012-13",
          "2013-14",
          "2014-15",
          "2015-16",
          "2016-17",
          "2017-18",
          "2018-19",
          "2019-20",
          "2020-21",
          "2021-22",
          "2022-23",
          "2023-24"
        ],
        "labels": [
          "2006–07",
          "2007–08",
          "2008–09",
          "2009–10",
          "2010–11",
          "2011–12",
          "2012–13",
          "2013–14",
          "2014–15",
          "2015–16",
          "2016–17",
          "2017–18",
          "2018–19",
          "2019–20",
          "2020–21",
          "2021–22",
          "2022–23",
          "2023–24"
        ]
      }
    }
  ],
  "config": {
    "background": "white",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelColor": "#555555",
      "titleColor": "#333333",
      "padding": 10
    }
  },
  "width": 700,
  "height": 520,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F2F2F2",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === startYear || datum.year === '2024-25'"
        },
        {
          "pivot": "year",
          "value": "production",
          "groupby": [
            "state",
            "state_code",
            "longitude",
            "latitude"
          ]
        },
        {
          "calculate": "datum['2024-25'] - datum[startYear]",
          "as": "change_ml"
        },
        {
          "calculate": "abs(datum.change_ml)",
          "as": "change_magnitude"
        },
        {
          "calculate": "datum.change_ml > 0 ? 'Growth' : datum.change_ml < 0 ? 'Decline' : 'No change'",
          "as": "direction"
        },
        {
          "calculate": "(datum.change_ml / datum[startYear]) * 100",
          "as": "change_pct"
        },
        {
          "calculate": "replace(startYear, '-', '–')",
          "as": "start_year_label"
        },
        {
          "calculate": "datum[startYear]",
          "as": "start_production"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "stroke": "#FFFFFF",
        "strokeWidth": 2
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "change_magnitude",
          "type": "quantitative",
          "title": "Absolute change (ML)",
          "scale": {
            "domain": [
              0,
              1200
            ],
            "range": [
              80,
              3000
            ]
          },
          "legend": {
            "orient": "right",
            "title": "Absolute change (ML)",
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "labelFontSize": 11,
            "format": ",.0f",
            "values": [
              250,
              500,
              1000
            ]
          }
        },
        "color": {
          "field": "direction",
          "type": "nominal",
          "title": "Direction",
          "scale": {
            "domain": [
              "Growth",
              "Decline",
              "No change"
            ],
            "range": [
              "#2F6B4F",
              "#6F6F6F",
              "#BDBDBD"
            ]
          },
          "legend": {
            "orient": "right",
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "labelFontSize": 11,
            "symbolSize": 120
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "start_year_label",
            "type": "nominal",
            "title": "Starting year"
          },
          {
            "field": "start_production",
            "type": "quantitative",
            "title": "Starting production (ML)",
            "format": ",.0f"
          },
          {
            "field": "2024-25",
            "type": "quantitative",
            "title": "2024–25 production (ML)",
            "format": ",.0f"
          },
          {
            "field": "change_ml",
            "type": "quantitative",
            "title": "Production change (ML)",
            "format": "+,.0f"
          },
          {
            "field": "change_pct",
            "type": "quantitative",
            "title": "Percentage change",
            "format": "+.1f"
          }
        ]
      },
