{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 850,
  "height": 240,
  "title": {
    "text": "Australia\u2019s Taste for Dairy Is Changing",
    "subtitle": [
      "Colour shows change in per-capita consumption from 2010\u201311. Hover to compare a year across products.",
      "*The yoghurt category expanded in 2014\u201315, affecting comparisons with earlier years."
    ],
    "anchor": "start",
    "fontSize": 20,
    "fontWeight": "bold",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 4,
    "offset": 22
  },
  "data": {
    "url": "vis08_dairy_consumption.csv"
  },
  "transform": [
    {
      "calculate": "format(datum.consumption, '.1f') + ' ' + datum.unit",
      "as": "consumption_display"
    },
    {
      "calculate": "datum.change_pct > 0 ? '+' + format(datum.change_pct, '.1f') + '%' : datum.change_pct < 0 ? format(datum.change_pct, '.1f') + '%' : '0%'",
      "as": "change_display"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "hoverYear",
          "select": {
            "type": "point",
            "fields": [
              "year"
            ],
            "on": "mouseover",
            "clear": "mouseout",
            "toggle": false
          }
        }
      ],
      "mark": {
        "type": "rect",
        "cornerRadius": 2,
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": "ascending",
          "axis": {
            "title": null,
            "orient": "top",
            "labelAngle": -45,
            "labelExpr": "replace(datum.label, '-', '\u2013')",
            "labelPadding": 10,
            "domain": false,
            "ticks": false
          }
        },
        "y": {
          "field": "product",
          "type": "nominal",
          "sort": [
            "Milk",
            "Cheese",
            "Butter & blends",
            "Yoghurt"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 12,
            "labelFontWeight": "bold",
            "labelPadding": 12,
            "domain": false,
            "ticks": false
          }
        },
        "color": {
          "field": "change_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              -20,
              45
            ],
            "domainMid": 0,
            "range": [
              "#75658A",
              "#F4F4F2",
              "#2F6B4F"
            ],
            "clamp": true
          },
          "legend": {
            "title": "Change from 2010\u201311",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 300,
            "values": [
              -20,
              -10,
              0,
              10,
              20,
              30,
              45
            ],
            "labelExpr": "datum.value === -20 ? '\u2264\u221220%' : datum.value === 45 ? '\u2265+45%' : datum.value > 0 ? '+' + datum.value + '%' : datum.value + '%'"
          }
        },
        "opacity": {
          "condition": {
            "param": "hoverYear",
            "value": 1
          },
          "value": 0.3
        },
        "tooltip": [
          {
            "field": "product",
            "type": "nominal",
            "title": "Dairy product"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Financial year"
          },
          {
            "field": "consumption_display",
            "type": "nominal",
            "title": "Per-capita consumption"
          },
          {
            "field": "change_display",
            "type": "nominal",
            "title": "Change from 2010\u201311"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "interactive": false
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": "ascending",
          "axis": {
            "title": null,
            "orient": "top",
            "labelAngle": -45,
            "labelExpr": "replace(datum.label, '-', '\u2013')",
            "labelPadding": 10,
            "domain": false,
            "ticks": false
          }
        },
        "y": {
          "field": "product",
          "type": "nominal",
          "sort": [
            "Milk",
            "Cheese",
            "Butter & blends",
            "Yoghurt"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 12,
            "labelFontWeight": "bold",
            "labelPadding": 12,
            "domain": false,
            "ticks": false
          }
        },
        "text": {
          "field": "change_display",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.change_pct <= -12 || datum.change_pct >= 27",
            "value": "#FFFFFF"
          },
          "value": "#333333"
        },
        "opacity": {
          "condition": {
            "param": "hoverYear",
            "value": 1
          },
          "value": 0.3
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "param": "hoverYear",
            "empty": false
          }
        }
      ],
      "mark": {
        "type": "rect",
        "filled": false,
        "stroke": "#333333",
        "strokeWidth": 1.5,
        "interactive": false
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": "ascending",
          "axis": {
            "title": null,
            "orient": "top",
            "labelAngle": -45,
            "labelExpr": "replace(datum.label, '-', '\u2013')",
            "labelPadding": 10,
            "domain": false,
            "ticks": false
          }
        },
        "y": {
          "field": "product",
          "type": "nominal",
          "sort": [
            "Milk",
            "Cheese",
            "Butter & blends",
            "Yoghurt"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 12,
            "labelFontWeight": "bold",
            "labelPadding": 12,
            "domain": false,
            "ticks": false
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === '2014-15' && datum.product === 'Yoghurt'"
        }
      ],
      "mark": {
        "type": "rect",
        "filled": false,
        "stroke": "#C46A2D",
        "strokeWidth": 2.5,
        "strokeDash": [
          5,
          4
        ],
        "interactive": false
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": "ascending",
          "axis": {
            "title": null,
            "orient": "top",
            "labelAngle": -45,
            "labelExpr": "replace(datum.label, '-', '\u2013')",
            "labelPadding": 10,
            "domain": false,
            "ticks": false
          }
        },
        "y": {
          "field": "product",
          "type": "nominal",
          "sort": [
            "Milk",
            "Cheese",
            "Butter & blends",
            "Yoghurt"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 12,
            "labelFontWeight": "bold",
            "labelPadding": 12,
            "domain": false,
            "ticks": false
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === '2014-15' && datum.product === 'Yoghurt'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#C46A2D",
        "interactive": false,
        "align": "right",
        "baseline": "top",
        "dx": 23,
        "dy": -25
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": "ascending",
          "axis": {
            "title": null,
            "orient": "top",
            "labelAngle": -45,
            "labelExpr": "replace(datum.label, '-', '\u2013')",
            "labelPadding": 10,
            "domain": false,
            "ticks": false
          }
        },
        "y": {
          "field": "product",
          "type": "nominal",
          "sort": [
            "Milk",
            "Cheese",
            "Butter & blends",
            "Yoghurt"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 12,
            "labelFontWeight": "bold",
            "labelPadding": 12,
            "domain": false,
            "ticks": false
          }
        },
        "text": {
          "value": "*"
        }
      }
    }
  ],
  "config": {
    "background": "white",
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "grid": false,
      "labelColor": "#555555"
    },
    "legend": {
      "labelColor": "#555555",
      "titleColor": "#444444"
    }
  }
}
